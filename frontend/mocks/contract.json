  "auth": "Demo login only — POST /auth/login returns a token; send as Authorization: Bearer or ignore it. NO real auth (post-hackathon).",

  "frontend_flow": {
    "$comment": "Every page, the route, and which endpoints feed it. Ayush: this is your endpoint build list.",
    "/login": { "desc": "Business login (name + business name → demo token)", "uses": ["POST /auth/login"] },
    "/onboarding": { "desc": "First-run wizard — business line, city, 'what eats your time' chips → lands on dashboard", "uses": ["PATCH /settings"] },
    "/dashboard": { "desc": "Home: KPI tiles (receivables, capital locked, pending approvals), aging + cashflow charts, activity feed, agent strip", "uses": ["GET /dashboard/summary", "GET /agents", "GET /alerts"] },
    "/agents": { "desc": "Subagents view — grid of all agents incl. AI-hired ones; 'hire agent' button opens factory wizard", "uses": ["GET /agents", "POST /agents/preview", "POST /agents"] },
    "/agents/:id": { "desc": "Agent detail — persona, tools, stats, activity log. RIGHT SIDEBAR is contextual per agent (vasool → invoice summary + capital locked; logistics agent → carriers/bookings)", "uses": ["GET /agents/{id}", "GET /agents/{id}/context", "POST /chat (agent_id)"] },
    "/tasks": { "desc": "Create task → assign to an agent → watch it run → result", "uses": ["GET /tasks", "POST /tasks", "POST /tasks/{id}/run"] },
    "/calendar": { "desc": "Month view — invoice dues, scheduled alerts, task deadlines", "uses": ["GET /calendar/events"] },
    "/notifications": { "desc": "Feed — drafted reminders awaiting approval, sent messages, agent-hired events, scheduler promotions", "uses": ["GET /notifications", "POST /alerts/{id}/approve"] },
    "/chat": { "desc": "Full chat view — orchestrator routing badges, agent pinning, action toasts", "uses": ["POST /chat"] },
    "/connectors": { "desc": "Connect existing services — Google Calendar, Airtable, WhatsApp, Tally, Razorpay. connect → syncing → items_synced", "uses": ["GET /connectors", "POST /connectors/{id}/connect", "POST /connectors/{id}/disconnect", "GET /connectors/{id}/sync"] },
    "/settings": { "desc": "Business profile, reminder cadence, approval mode, language, notify email", "uses": ["GET /settings", "PATCH /settings"] }
  },

