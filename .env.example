# --- Core toggle ---
# 0 = fully local (LocalStore/ConsoleNotifier/MockModel), 1 = AWS (DynamoDB/SES/S3/Bedrock)
USE_AWS=0

# --- Bedrock models (verified: Strands BedrockModel takes inference-profile IDs) ---
ORCHESTRATOR_MODEL=us.amazon.nova-pro-v1:0
WORKER_MODEL=us.amazon.nova-lite-v1:0
AWS_REGION=us-east-1
AWS_PROFILE=hackathon

# --- DynamoDB tables (partner creates per plan §7) ---
DDB_TABLE_SPECS=sahayak-agent-specs
DDB_TABLE_INVOICES=sahayak-invoices
DDB_TABLE_SUPPLIERS=sahayak-suppliers
DDB_TABLE_ALERTS=sahayak-alerts

# --- SES (sandbox: recipient must ALSO be verified) ---
SES_SENDER=sahayak@example.com

# --- S3 uploads ---
S3_BUCKET=sahayak-uploads

# --- Demo ---
DEFAULT_TENANT=ramesh_auto
