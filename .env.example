# --- Core toggle ---
# 0 = fully local (LocalStore/ConsoleNotifier/MockModel), 1 = AWS (DynamoDB/SES/S3/Bedrock)
USE_AWS=0

# --- Bedrock models (verified: Strands BedrockModel takes inference-profile IDs) ---
ORCHESTRATOR_MODEL=us.amazon.nova-pro-v1:0
WORKER_MODEL=us.amazon.nova-lite-v1:0
AWS_REGION=us-east-1
AWS_PROFILE=hackathon
# ^ preferred: Ayush runs `aws configure --profile hackathon` — keys live in
#   ~/.aws/credentials, NEVER in this file. boto3/Strands pick them up via the profile.
# Option B (only if profile setup fails): put real keys in the untracked .env —
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# --- DynamoDB tables — ONE per collection (13 total). PK tenant_id (S) + SK id (S).
#     Defaults to sahayak-<collection>; only set a var if your table name differs. ---
DDB_TABLE_SPECS=sahayak-specs
DDB_TABLE_INVOICES=sahayak-invoices
DDB_TABLE_SUPPLIERS=sahayak-suppliers
DDB_TABLE_CARRIERS=sahayak-carriers
DDB_TABLE_ALERTS=sahayak-alerts
DDB_TABLE_PAYABLES=sahayak-payables
DDB_TABLE_TASKS=sahayak-tasks
DDB_TABLE_NOTIFICATIONS=sahayak-notifications
DDB_TABLE_CONNECTORS=sahayak-connectors
DDB_TABLE_SETTINGS=sahayak-settings
DDB_TABLE_ACTIVITY=sahayak-activity
DDB_TABLE_MEMORIES=sahayak-memories
DDB_TABLE_ARTIFACTS=sahayak-artifacts
DDB_TABLE_DOCUMENTS=sahayak-documents

# --- SES (sandbox: recipient must ALSO be verified) ---
SES_SENDER=kkfahmin@gmail.com

# --- S3 uploads ---
S3_BUCKET=sahayak-uploads

# --- Demo ---
DEFAULT_TENANT=ramesh_auto
