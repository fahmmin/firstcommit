# --- Core toggle ---
# 0 = fully local (LocalStore/ConsoleNotifier/MockModel), 1 = AWS (DynamoDB/SES/S3/Bedrock)
USE_AWS=0

# --- Bedrock models (verified: Strands BedrockModel takes inference-profile IDs) ---
ORCHESTRATOR_MODEL=us.amazon.nova-pro-v1:0
WORKER_MODEL=us.amazon.nova-lite-v1:0
AWS_REGION=us-east-1
AWS_PROFILE=hackathon
# ^ preferred: Ayush runs `aws configure --profile hackathon` — keys live in
#   ~/.aws/credentials, NEVER in this file. boto3/Strands pick them up via the profile.
# Option B (only if profile setup fails): put real keys in the untracked .env —
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# --- DynamoDB tables — ONE per collection (13 total). PK tenant_id (S) + SK id (S).
#     Defaults to sahayak-<collection>; only set a var if your table name differs. ---
DDB_TABLE_SPECS=sahayak-specs
DDB_TABLE_INVOICES=sahayak-invoices
DDB_TABLE_SUPPLIERS=sahayak-suppliers
DDB_TABLE_CARRIERS=sahayak-carriers
DDB_TABLE_ALERTS=sahayak-alerts
DDB_TABLE_PAYABLES=sahayak-payables
DDB_TABLE_TASKS=sahayak-tasks
DDB_TABLE_NOTIFICATIONS=sahayak-notifications
DDB_TABLE_CONNECTORS=sahayak-connectors
DDB_TABLE_SETTINGS=sahayak-settings
DDB_TABLE_ACTIVITY=sahayak-activity
DDB_TABLE_MEMORIES=sahayak-memories
DDB_TABLE_ARTIFACTS=sahayak-artifacts
DDB_TABLE_DOCUMENTS=sahayak-documents

# --- SES (sandbox: recipient must ALSO be verified) ---
SES_SENDER=kkfahmin@gmail.com

# --- S3 uploads ---
S3_BUCKET=sahayak-uploads

# --- Demo ---
DEFAULT_TENANT=ramesh_auto

# --- Deploy (simulation/deploy_aws.py) ---
# Site-wide passcode — the "auth stays demo-only" gate. Set to deploy public.
# Judges open https://<site>/?gate=TOKEN#/app once; token sticks in localStorage.
DEMO_GATE_TOKEN=
# Signs the RBAC session tokens (backend/app/auth.py). Any long random string;
# keep it stable or every restart/deploy signs everyone out. Dev default if unset.
AUTH_SECRET=
# Optional overrides the deploy script honours:
# LAMBDA_FUNCTION_NAME=sahayak-api
# LAMBDA_ROLE_NAME=sahayak-lambda-role
# LAMBDA_ROLE_ARN=             # if a role already exists, skip iam:CreateRole

# ======================================================================
# AUTH + OAUTH CONNECTORS — currently all STUBBED (see AYUSH.md §OAuth).
# Login is demo-only (POST /auth/login accepts anything). Real auth +
# connector OAuth need these filled AND new callback routes built.
# ======================================================================

# --- App auth (REQUIRED for real login + private-artifact ACL) ---
# JWT signing secret for session tokens. Generate: openssl rand -hex 32
AUTH_JWT_SECRET=
# Where issued tokens/cookies point back to
PUBLIC_API_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:5173

# --- Google service account (REAL connectors: drive/sheets/docs/calendar) ---
# Project: sahayak-connect-24b14f — SA: sahayak-connector@sahayak-connect-24b14f...
# Connect = the owner SHARES Drive files / Sheets / Docs / a Calendar with the
# SA's client_email — no OAuth consent screen needed. Sync then reads them.
# Paste the FULL key JSON on ONE line (Lambda env var):
GOOGLE_SERVICE_ACCOUNT_JSON=
# OR for local dev, point at the key file instead (never commit it):
# GOOGLE_SA_KEY_FILE=gcp-sa.json

# --- Google (ONE OAuth client covers Gmail + Drive + Calendar) ---
# console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web)
# Enable: Gmail API, Google Drive API, Google Calendar API
# Authorized redirect URI: {PUBLIC_API_URL}/connectors/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${PUBLIC_API_URL}/connectors/google/callback
# Scopes to request (space-separated):
#   gmail.readonly gmail.send drive.readonly calendar.events openid email

# --- Meta (ONE app covers WhatsApp Business + Facebook + Instagram) ---
# developers.facebook.com → Create App → add WhatsApp + Messenger products
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=${PUBLIC_API_URL}/connectors/meta/callback
# WhatsApp Business: permanent access token + phone number id + webhook verify
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=          # any random string you set in the webhook config
# NOTE: Facebook Marketplace has NO public listing API — connector stays manual.

# --- Razorpay (API keys, not OAuth) — dashboard.razorpay.com → Settings → API Keys ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=        # for payment-link paid callbacks

# --- Shopify — partner dashboard → custom app OAuth ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_orders
SHOPIFY_REDIRECT_URI=${PUBLIC_API_URL}/connectors/shopify/callback

# --- IndiaMART — partner API key (contact indiamart partner program) ---
INDIAMART_API_KEY=

# --- Airtable — OAuth (airtable.com/create/oauth) or a PAT for demo ---
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
AIRTABLE_PAT=                   # simplest path: personal access token, data.records.read

# --- Slack — api.slack.com/apps → OAuth + webhook signing secret ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=${PUBLIC_API_URL}/connectors/slack/callback

# --- Tally — no OAuth. TallyPrime exposes HTTP on the LAN; this is its URL ---
TALLY_GATEWAY_URL=http://localhost:9000

# --- Token storage — where OAuth refresh tokens live (never plaintext in DDB) ---
# options: secretsmanager | ddb-encrypted | ssm
TOKEN_STORE=secretsmanager

# --- Web search / deep research tool (mock_rules → real) ---
TAVILY_API_KEY=
DDB_TABLE_LISTINGS=sahayak-listings
DDB_TABLE_APPROVALS=sahayak-approvals

# --- B2: model provider seam (backend/app/providers.py) ---
# Leave unset for today's behaviour: USE_AWS=1 → Bedrock Nova + Titan, USE_AWS=0 → offline mock.
# MODEL_PROVIDER=bedrock|anthropic|openai|ollama|litellm|mock
# EMBED_PROVIDER=titan|openai|ollama|none   (switching? POST /context/reembed afterwards)
# Non-Bedrock chat agents need: pip install -r backend/requirements-providers.txt
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_HOST=http://localhost:11434
# Per-provider model ids (defaults in providers.py), e.g.:
# ANTHROPIC_ORCHESTRATOR_MODEL=claude-sonnet-5
# ANTHROPIC_WORKER_MODEL=claude-haiku-4-5-20251001
# OPENAI_EMBED_MODEL=text-embedding-3-small
